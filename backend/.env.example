# Lokalnie (bez dockera backendu) – Postgres z docker-compose wystawiony na localhost:5432
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# Wygeneruj: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Klucz endpointów serwisowych (generator danych: /health/service/*). Bez niego są wyłączone.
# Wygeneruj: python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_KEY=

CHROMA_PATH=./data/chroma
CHROMA_HOST=localhost
CHROMA_PORT=8001
UPLOAD_DIR=./data/uploads

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Azure OpenAI – required for embeddings (memory, RAG); without it chat falls back to the stub LLM
AZURE_OPENAI_ENDPOINT=https://<nazwa-zasobu>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Nazwy DEPLOYMENTÓW z Azure AI Foundry (nie nazwy modeli)
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_VISION_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
